# ─── DATABASE ──────────────────────────────────────────
# Supabase PostgreSQL (o cualquier PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ─── APP ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── AUTH ──────────────────────────────────────────────
# IMPORTANTE: Cambiar en produccion. Minimo 32 caracteres random.
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR-EN-PRODUCCION

# ─── FIREBASE (Storage de fotos) ──────────────────────
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_STORAGE_BUCKET=gs://tu-proyecto.firebasestorage.app
# Ruta al JSON de credenciales de Firebase Admin SDK
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ─── MERCADOPAGO ──────────────────────────────────────
mercadopago_public_key=APP_USR-xxxxx
mercadopago_access_token=APP_USR-xxxxx
# URL publica donde MP envia webhooks (usar ngrok en dev, dominio real en prod)
mercadopago_webhook_url=https://tu-dominio.com/api/webhooks/mercadopago
