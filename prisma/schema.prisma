generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ──────────────────────────────────────────────

enum UserRole {
  USER
  COMMUNITY_LEADER
  ADMIN
}

enum UserStatus {
  active
  blocked
  deleted
}

enum Gender {
  male
  female
  non_binary
  na
}

enum ActivityType {
  trekking
  theater
  dance
  fitness
  outdoor
  wellness
  gastronomy
  music
  art
  sports
  other
}

enum EnrollmentStatus {
  pending
  confirmed
  attended
  cancelled
}

enum SwipeAction {
  LIKE
  PASS
}

enum BankAccountType {
  cuenta_corriente
  cuenta_vista
  cuenta_ahorro
  cuenta_rut
}

enum TransferStatus {
  pending
  transferred
  cancelled
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}


enum NotificationType {
  enrollment_confirmed
  match_created
  session_reminder
  payment_received
  new_like
  session_full
  payment_confirmed
  new_enrollment
  transfer_completed
  subscription_payment_due
  subscription_payment_confirmed
  subscription_overdue
  subscription_cancelled
  new_subscriber
}

enum ActivityPricingModel {
  per_session
  monthly_subscription
}

enum SubscriptionStatus {
  active
  pending_payment
  overdue
  cancelled
}

enum SubscriptionBillingStatus {
  pending
  paid
  failed
  cancelled
}

enum EnrollmentPaymentStatus {
  pending_payment
  paid
  free
}

// ─── USERS ──────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  phone        String?    @unique
  username     String?    @unique
  roles        UserRole[] @default([USER])
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  expoPushToken String?

  profile       UserProfile?
  interests     UserInterest[]
  activities    Activity[]           @relation("activity_creator")
  enrollments   ActivityEnrollment[]
  swipesGiven   SwipeEvent[]         @relation("swipes_given")
  swipesReceived SwipeEvent[]        @relation("swipes_received")
  matchesAsA    Match[]              @relation("match_user_a")
  matchesAsB    Match[]              @relation("match_user_b")
  notifications  Notification[]
  photos         UserPhoto[]
  bankInfo       LeaderBankInfo?
  payments                   Payment[]              @relation("UserPayments")
  leaderPayments             Payment[]              @relation("LeaderPayments")
  subscriptions              Subscription[]
  leaderSubscriptionBillings SubscriptionBilling[]   @relation("LeaderSubscriptionBillings")
}

model UserProfile {
  userId    String    @id
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String?
  birthdate DateTime?
  gender    Gender?
  bio       String?
  avatarUrl String?
  city      String?
  latitude  Float?
  longitude Float?
}

// ─── INTERESTS ──────────────────────────────────────────

model Interest {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique

  users      UserInterest[]
  activities ActivityInterest[]
}

model UserInterest {
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

// ─── ACTIVITIES & SESSIONS ──────────────────────────────

model Activity {
  id          String       @id @default(uuid())
  slug        String       @unique
  title       String
  type        ActivityType
  description String?
  isActive    Boolean      @default(true)
  createdById String
  createdBy   User         @relation("activity_creator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  pricingModel       ActivityPricingModel @default(per_session)
  monthlyPriceCents  Int?

  sessions      ActivitySession[]
  interests     ActivityInterest[]
  payments      Payment[]
  subscriptions Subscription[]
}

model ActivityInterest {
  activityId String
  interestId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([activityId, interestId])
}

model ActivitySession {
  id           String   @id @default(uuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  capacity     Int?
  priceCents   Int?
  locationName String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments ActivityEnrollment[]
  swipes      SwipeEvent[]
  matches     Match[]
}

model ActivityEnrollment {
  id            String                  @id @default(uuid())
  sessionId     String
  session       ActivitySession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        EnrollmentStatus        @default(pending)
  paymentStatus EnrollmentPaymentStatus @default(free)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  payment Payment?

  @@unique([sessionId, userId])
}

// ─── SOCIAL: SWIPES & MATCHES ───────────────────────────

model SwipeEvent {
  id        String           @id @default(uuid())
  byUserId  String
  toUserId  String
  sessionId String?
  action    SwipeAction
  byUser    User             @relation("swipes_given", fields: [byUserId], references: [id])
  toUser    User             @relation("swipes_received", fields: [toUserId], references: [id])
  session   ActivitySession? @relation(fields: [sessionId], references: [id])
  createdAt DateTime         @default(now())

  @@index([toUserId, sessionId])
  @@index([byUserId, sessionId])
  @@index([byUserId, toUserId])
}

model Match {
  id        String           @id @default(uuid())
  userAId   String
  userBId   String
  sessionId String?
  userA     User             @relation("match_user_a", fields: [userAId], references: [id])
  userB     User             @relation("match_user_b", fields: [userBId], references: [id])
  session   ActivitySession? @relation(fields: [sessionId], references: [id])
  createdAt DateTime         @default(now())

  @@index([userAId])
  @@index([userBId])
}

// ─── PAYMENTS ─────────────────────────────────────────────

model Payment {
  id              String         @id @default(uuid())
  userId          String
  activityId      String
  enrollmentId    String         @unique
  leaderId        String
  totalAmount     Decimal        @db.Decimal(10,2)
  platformFee     Decimal        @db.Decimal(10,2)
  leaderAmount    Decimal        @db.Decimal(10,2)
  mpPreferenceId  String?
  mpPaymentId     String?        @unique
  mpStatus        String?
  paymentMethod   String         @default("mercadopago")
  status          PaymentStatus  @default(pending)
  transferStatus  TransferStatus @default(pending)
  transferredAt   DateTime?
  transferredBy   String?
  transferNotes   String?
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user       User               @relation("UserPayments", fields: [userId], references: [id])
  activity   Activity           @relation(fields: [activityId], references: [id])
  enrollment ActivityEnrollment @relation(fields: [enrollmentId], references: [id])
  leader     User               @relation("LeaderPayments", fields: [leaderId], references: [id])

  @@index([leaderId])
  @@index([status])
  @@index([transferStatus])
}

// ─── NOTIFICATIONS ────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
}

// ─── USER PHOTOS ─────────────────────────────────────────

model UserPhoto {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url            String
  storageKey     String?
  originalFormat String?
  format         String   @default("webp")
  position       Int
  sizeBytes      Int?
  width          Int?
  height         Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, position])
}

// ─── LEADER BANK INFO ────────────────────────────────────

model LeaderBankInfo {
  id            String          @id @default(uuid())
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rut           String
  holderName    String
  bankName      String
  accountType   BankAccountType
  accountNumber String
  email         String
  isVerified    Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// ─── SUBSCRIPTIONS ───────────────────────────────────────

model Subscription {
  id                 String             @id @default(uuid())
  userId             String
  activityId         String
  status             SubscriptionStatus @default(pending_payment)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity               @relation(fields: [activityId], references: [id], onDelete: Cascade)
  billings SubscriptionBilling[]

  @@unique([userId, activityId])
}

model SubscriptionBilling {
  id               String                    @id @default(uuid())
  subscriptionId   String
  leaderId         String
  periodStart      DateTime
  periodEnd        DateTime
  dueDate          DateTime
  totalAmount      Decimal                   @db.Decimal(10, 2)
  platformFee      Decimal                   @db.Decimal(10, 2)
  leaderAmount     Decimal                   @db.Decimal(10, 2)
  mpPreferenceId   String?
  mpPaymentId      String?                   @unique
  mpStatus         String?
  status           SubscriptionBillingStatus @default(pending)
  transferStatus   TransferStatus            @default(pending)
  transferredAt    DateTime?
  transferredBy    String?
  transferNotes    String?
  paidAt           DateTime?
  notifiedAt       DateTime?
  reminderSentAt   DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  leader       User         @relation("LeaderSubscriptionBillings", fields: [leaderId], references: [id])

  @@index([subscriptionId])
  @@index([status])
  @@index([transferStatus])
  @@index([dueDate])
}
